uniform float4x4 ViewProj;
uniform texture2d left_image;
uniform texture2d right_image;
uniform float2 uv_mul;
uniform float2 uv_add;
uniform float left_dominant;
uniform float4 left_map;
uniform float4 right_map;

sampler_state texture_sampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vert_in.uv;
	return vert_out;
}

float4 PSMixedEyes(VertInOut vert_in) : TARGET
{
	float2 source_uv = vert_in.uv * uv_mul + uv_add;
    float2 lu = source_uv * left_map.xy + left_map.zw;
    float2 ru = source_uv * right_map.xy + right_map.zw;
    bool lv = all(lu >= 0.0) && all(lu <= 1.0);
    bool rv = all(ru >= 0.0) && all(ru <= 1.0);
    float3 left = left_image.Sample(texture_sampler, saturate(lu)).rgb;
    float3 right = right_image.Sample(texture_sampler, saturate(ru)).rgb;
    float2 du = left_dominant > 0.5 ? lu : ru;
    float w = smoothstep(0.0, 0.015, min(du.x, 1.0-du.x));
    if (!lv && !rv) return float4(0,0,0,1);
    if (!lv) return float4(right,1);
    if (!rv) return float4(left,1);
    return float4(left_dominant > 0.5 ? lerp(right,left,w) : lerp(left,right,w),1);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader = PSMixedEyes(vert_in);
	}
}
